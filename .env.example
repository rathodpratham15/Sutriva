# TraceLens configuration. Copy to .env or export these in your shell.
# Nothing here is required to try TraceLens -- without a key, TRACELENS_VISION_PROVIDER
# defaults to "mock" (deterministic, offline, no network calls).

# Enables the real Anthropic vision provider for frame/segment analysis.
ANTHROPIC_API_KEY=

# Optional overrides:
# TRACELENS_VISION_PROVIDER=anthropic   # or "mock" (default when no key is set)
# TRACELENS_VISION_MODEL=claude-opus-5  # any current vision-capable Claude model
# TRACELENS_DATA_DIR=./.tracelens       # where sessions/timelines/frames are stored
