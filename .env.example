# Sutriva configuration. Copy to .env or export these in your shell.
# Nothing here is required to try Sutriva -- without a key, SUTRIVA_VISION_PROVIDER
# defaults to "mock" (deterministic, offline, no network calls).

# Enables the real Anthropic vision provider for frame/segment analysis.
ANTHROPIC_API_KEY=

# Enables the real ElevenLabs (Scribe) transcription provider for audio.
ELEVENLABS_API_KEY=

# Optional overrides:
# SUTRIVA_VISION_PROVIDER=anthropic          # or "mock" (default when no key is set)
# SUTRIVA_VISION_MODEL=claude-opus-5         # any current vision-capable Claude model
# SUTRIVA_TRANSCRIPTION_PROVIDER=elevenlabs  # or "mock" (default when no key is set)
# SUTRIVA_TRANSCRIPTION_MODEL=scribe_v1      # or "scribe_v2"
# SUTRIVA_DATA_DIR=./.sutriva              # where sessions/timelines/frames are stored
