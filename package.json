{
  "name": "tracelens",
  "private": true,
  "version": "0.1.0",
  "description": "Temporal context and debugging system for Claude Code",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/* exec tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx tests/eval/run-eval.ts",
    "cli": "tsx apps/cli/src/index.ts",
    "mcp": "tsx apps/mcp-server/src/index.ts",
    "fixtures:generate": "bash scripts/generate-fixtures.sh",
    "fixtures:eval:generate": "tsx scripts/generate-eval-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tracelens/core": "workspace:*",
    "@tracelens/video": "workspace:*",
    "@tracelens/providers": "workspace:*",
    "@tracelens/storage": "workspace:*",
    "@tracelens/timeline": "workspace:*",
    "@tracelens/git": "workspace:*",
    "@tracelens/browser": "workspace:*",
    "@tracelens/live": "workspace:*",
    "typescript": "^5.6.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10",
    "eslint": "^9.13.0",
    "typescript-eslint": "^8.15.0"
  },
  "packageManager": "pnpm@10.11.0"
}
